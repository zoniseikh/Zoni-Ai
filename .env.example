# ============================================================
# ZONI AI — Server Environment Configuration (.env.example)
# NEVER commit real secrets or private keys to version control.
# ============================================================

# Required (Server-side ONLY): Google Gemini API key used by server.ts
# Never expose this key in client JavaScript bundles or Android APKs.
GEMINI_API_KEY="YOUR_SERVER_SIDE_GEMINI_API_KEY"

# Server runtime binding (Cloud Run / Render / Railway / Docker)
NODE_ENV="production"
HOST="0.0.0.0"
PORT="3000"

# Public HTTPS URL where your Zoni AI Express + WebSocket backend is deployed
APP_URL="https://zoni-ai-675435111499.asia-southeast1.run.app"

# Production default for Android WebView / Capacitor builds:
# Defaults automatically to https://zoni-ai-675435111499.asia-southeast1.run.app on Android,
# and can also be updated at runtime in Zoni Setup -> Step 1 (Backend Link).
VITE_BACKEND_URL="https://zoni-ai-675435111499.asia-southeast1.run.app"

# ============================================================
# GitHub Actions Variables / Secrets (Optional)
# ============================================================
# ZONI_BACKEND_URL (GitHub Repository Variable — defaults to https://zoni-ai-675435111499.asia-southeast1.run.app)
# ANDROID_KEY_BASE64 (GitHub Secret: base64 of .jks release keystore)
# ANDROID_KEY_ALIAS (GitHub Secret)
# ANDROID_KEY_PASSWORD (GitHub Secret)
# ANDROID_KEYSTORE_PASSWORD (Optional GitHub Secret if different from key password)
