# ============================================================
# ZONI AI — Server Environment Configuration (.env.example)
# NEVER commit real secrets or private keys to version control.
# ============================================================

# Required: Server-side Gemini API Key (never exposed to browser or Android APK)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL where the Zoni AI Express + WebSocket backend is hosted
APP_URL="http://localhost:3000"

# Optional: Static Bearer token protecting /api/calls/* and /api/tasks/* endpoints
# Leave empty during local development
ZONI_API_AUTH_TOKEN=""

# ============================================================
# Hybrid AI VoIP Calling Provider (Optional — External PSTN/SIP)
# If left empty, Zoni AI runs in honest `unconfigured` mode and
# NEVER fabricates external VoIP calls.
# ============================================================

# Supported values: twilio | sip_webhook
VOIP_PROVIDER=""

# Option 1: Twilio Programmable Voice + Media Streams
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_MEDIA_STREAM_WSS=""

# Option 2: Generic SIP Gateway Webhook Adapter
SIP_TRUNK_URI=""
SIP_GATEWAY_WEBHOOK_URL=""
SIP_GATEWAY_BEARER_TOKEN=""

# ============================================================
# Android Release Signing (Configure as GitHub Actions Secrets)
# Debug APKs build automatically without signing credentials.
# ============================================================
# ANDROID_KEYSTORE_BASE64 (GitHub Secret: base64 of .jks file)
# ANDROID_KEYSTORE_PASSWORD (GitHub Secret)
# ANDROID_KEY_ALIAS (GitHub Secret)
# ANDROID_KEY_PASSWORD (GitHub Secret)
